{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboprintifc/schemas/toolpath.schema.json",
  "title": "Toolpath",
  "description": "Geometrische Druckanweisung, roboterunabhaengig und zeitfrei. io fuehrt logische Kanaele (ADR-011/E2); hier endet die Welt der Geometrie.",
  "type": "object",
  "required": ["schema_version", "provenance", "wall_global_id", "targets", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": ["0.2", "0.3"],
      "description": "0.2 = summary-Block; 0.3 = zusaetzlich params-Block fuer Viewer-Parameter-Panel (Issue #9)"
    },
    "provenance": { "$ref": "setup.schema.json#/$defs/provenance" },
    "wall_global_id": { "type": "string", "description": "IFC GlobalId der Quellwand" },
    "summary": {
      "type": "object",
      "description": "Vorberechnete Kennzahlen: der Core rechnet sie einmal, Anzeige und Viewer lesen nur (ADR-007). Ab schema_version 0.2.",
      "required": ["n_layers", "n_targets", "n_print"],
      "additionalProperties": false,
      "properties": {
        "n_layers": { "type": "integer", "minimum": 1, "description": "Anzahl Druckschichten (max(layer)+1)" },
        "n_targets": { "type": "integer", "minimum": 1, "description": "Anzahl aller Bahnpunkte (print + travel)" },
        "n_print": { "type": "integer", "minimum": 0, "description": "Anzahl der print-Bahnpunkte" }
      }
    },
    "params": {
      "type": "object",
      "description": "Slice-Parameter, mit denen der Lauf erzeugt wurde (ab schema_version 0.3; fehlt bei aelteren 0.2-Laeufen). Einstiegspunkt fuer das Viewer-Parameter-Panel (Issue #9, ADR-014).",
      "required": ["model_path", "layer_height_mm", "strand_width_mm", "n_shells"],
      "additionalProperties": false,
      "properties": {
        "model_path": { "type": "string", "description": "Absoluter Pfad zur Quell-IFC-Datei (aufgeloest, plattformunabhaengig)" },
        "layer_height_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Schichthoehe in mm" },
        "strand_width_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Strangbreite in mm" },
        "n_shells": { "type": "integer", "minimum": 1, "description": "Anzahl Schalen je Kontur" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame", "v_mm_s", "io", "kind", "layer", "segment_id"],
        "additionalProperties": false,
        "properties": {
          "frame": { "$ref": "setup.schema.json#/$defs/frame" },
          "v_mm_s": { "type": "number", "exclusiveMinimum": 0 },
          "io": {
            "type": "object",
            "description": "Logischer Kanalname -> Wert (Default-Bereich 0..1); Mapping auf physische Ausgaenge liegt im Setup (E2)",
            "additionalProperties": { "type": "number" }
          },
          "kind": { "enum": ["print", "travel"] },
          "layer": { "type": "integer", "minimum": 0 },
          "segment_id": { "type": "string" }
        }
      }
    }
  }
}
