{
  "$defs": {
    "PatternOutlineBox": {
      "additionalProperties": false,
      "description": "Rechteckiger Querschnitt, Ursprung in der Mitte (x ∈ [−L/2, L/2], y ∈ [−d/2, d/2]).",
      "properties": {
        "length_mm": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "type": "number"
        },
        "thickness_mm": {
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "type": "number"
        }
      },
      "required": [
        "length_mm",
        "thickness_mm"
      ],
      "title": "PatternOutlineBox",
      "type": "object"
    },
    "PatternOutlinePolygon": {
      "additionalProperties": false,
      "description": "Beliebiger Querschnitt als Polygon (Frame P, mm) mit optionalen Löchern.",
      "properties": {
        "holes": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        "polygon": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "polygon",
        "holes"
      ],
      "title": "PatternOutlinePolygon",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Body von `POST /api/patterns/presets`. Ohne `id` wird sie aus dem Namen gebildet. Eine\neigene Vorlage mit derselben id wird überschrieben, eine mitgelieferte nie (409).",
  "properties": {
    "description": {
      "default": "",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "outline": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatternOutlineBox"
        },
        {
          "$ref": "#/$defs/PatternOutlinePolygon"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "params": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": "object"
    },
    "pattern": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "pattern",
    "params",
    "outline",
    "description"
  ],
  "title": "PatternPresetCreate",
  "type": "object"
}
