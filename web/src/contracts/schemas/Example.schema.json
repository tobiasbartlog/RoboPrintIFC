{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "ifc",
        "scenario"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "path",
    "description"
  ],
  "title": "Example",
  "type": "object"
}
