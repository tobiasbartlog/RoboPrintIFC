{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "state",
    "progress",
    "stage",
    "message",
    "run_id"
  ],
  "title": "JobState",
  "type": "object"
}
