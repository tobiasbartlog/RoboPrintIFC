{
  "$defs": {
    "PartEntry": {
      "additionalProperties": false,
      "properties": {
        "d_min_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "n_collision": {
          "minimum": 0,
          "type": "integer"
        },
        "n_unreachable": {
          "minimum": 0,
          "type": "integer"
        },
        "part_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "machbar",
            "nicht machbar"
          ],
          "type": "string"
        },
        "wall_id": {
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "wall_id",
        "status",
        "d_min_mm",
        "n_collision",
        "n_unreachable"
      ],
      "title": "PartEntry",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "git_commit",
        "created",
        "command"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "WallEntry": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "height_mm": {
          "type": "number"
        },
        "length_mm": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "part_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "thickness_mm": {
          "type": "number"
        },
        "volume_mm3": {
          "type": "number"
        },
        "wall_id": {
          "type": "string"
        }
      },
      "required": [
        "wall_id",
        "name",
        "eligible",
        "reason",
        "length_mm",
        "thickness_mm",
        "height_mm",
        "volume_mm3",
        "part_ids"
      ],
      "title": "WallEntry",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "params": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "type": "object"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/PartEntry"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_path": {
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "type": "string"
    },
    "timings_s": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "walls": {
      "items": {
        "$ref": "#/$defs/WallEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_path",
    "params",
    "assumptions",
    "walls",
    "parts",
    "timings_s",
    "provenance"
  ],
  "title": "Summary",
  "type": "object"
}
