{
  "$defs": {
    "Ring": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "outer",
            "inner",
            "hole",
            "infill",
            "web",
            "outfill"
          ],
          "type": "string"
        },
        "layer": {
          "minimum": 0,
          "type": "integer"
        },
        "link_next": {
          "default": false,
          "type": "boolean"
        },
        "shell": {
          "minimum": 0,
          "type": "integer"
        },
        "waypoints": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 7,
            "minItems": 7,
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "layer",
        "shell",
        "kind",
        "closed",
        "link_next",
        "waypoints"
      ],
      "title": "Ring",
      "type": "object"
    },
    "ToolpathPattern": {
      "additionalProperties": false,
      "description": "Druckmuster eines Teils (opt-in, docs/muster/ARTEFAKT-FORMAT.md); nur zur Beschriftung.",
      "properties": {
        "infill": {
          "type": "string"
        },
        "layer_order": {
          "enum": [
            "same",
            "alternate"
          ],
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outfill": {
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "layer_order",
        "infill",
        "outfill",
        "params"
      ],
      "title": "ToolpathPattern",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bead_width_mm": {
      "type": "number"
    },
    "layer_height_mm": {
      "type": "number"
    },
    "part_id": {
      "type": "string"
    },
    "pattern": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolpathPattern"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rings": {
      "items": {
        "$ref": "#/$defs/Ring"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "part_id",
    "layer_height_mm",
    "bead_width_mm",
    "rings"
  ],
  "title": "Toolpath",
  "type": "object"
}
