# Python
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / Viewer
node_modules/
viewer/dist/
legacy/viewer/dist/
web/dist/
web/test-results/
web/playwright-report/

# Laufordner (Artefakte, ADR-004) — nie versionieren
runs/*
!runs/README.md

# Projekte (Arbeitsstände, ADR-016) — verweisen auf Läufe, nie versionieren
projects/*
!projects/README.md

# IDE / OS
.idea/
.vscode/
Thumbs.db
desktop.ini

# Lokale Werkzeug-/Assistenz-Konfiguration. Versioniert sind nur die geteilten
# Claude-Code-Dateien (settings.json, hooks/, cloud/), die die Cloud-Session braucht.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/cloud/
.codex/

