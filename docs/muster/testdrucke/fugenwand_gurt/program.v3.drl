# RoboPrintIFC v2 - DRL-Programm fuer Doosan M1013 (Lehm-3D-Druck)
# Dialekt: v3 (Befehle ab V3 erlaubt), Druck als movel mit Blending
# Szenario: testdruck_fugenwand_gurt
# Teil: box_01 (Wand box), Status: machbar, 90 Ringe in 1 Straengen (89 Verbinder), 13126 Samples, 2294 Bewegungsbefehle
# Provenienz: git 794843386fa82a5260373ca2cf60da0c2624f4b4, erstellt 2026-10-21T06:51:44+00:00, Kommando: /home/user/RoboPrintIFC/core/src/roboprint/__main__.py run-scenario docs/muster/testdrucke/fugenwand_gurt/scenario.json --out runs/muster_testdrucke/testdruck_fugenwand_gurt --jobs 2
# Posen: posx = T_BT (TCP in Roboterbasis B) in mm und Grad, Euler ZYZ, ref=DR_BASE;
#        posj in Grad, Doosan-Konvention. Alle Ziele stammen aus trajectory.json.
# Strang: Ringe und Verbinder ohne Halt, die Pumpe laeuft durch. Pumpe an + wait(t_tot) nur am
#         Strangbeginn, Pumpe aus nur am Strangende (letztes movel mit radius=0).
#
# ACHTUNG: Trockenlauf mit reduzierter Geschwindigkeit vor dem ersten Druck
#          (ohne Material, change_operation_speed 10..20 %).
#
# Provisorische Werte (SPEC 10, A = Annahme, vom Nutzer zu bestaetigen; N = Nutzervorgabe):
#   A Schichthoehe h            10.0 mm
#   A Strangbreite w            30.0 mm
#   A v_print                   100.0 mm/s, 60.0 deg/s (acc 500.0 mm/s2, 120.0 deg/s2)
#   A v_travel                  250.0 mm/s, 90.0 deg/s (acc 1000.0 mm/s2, 180.0 deg/s2)
#   A Gelenke                   30 % der Grenzen: [36.0, 36.0, 54.0, 67.5, 67.5, 67.5] deg/s, acc = 4 x vel
#   A z_lift                    30.0 mm ueber Druckstand-Oberkante
#   A An- und Abfahrt           senkrecht 20.0 mm
#   A V_pump                    5.0 V konstant auf AO 1 (pump_a)
#   A t_tot                     3.0 s Pumpen-Vorlauf am Strangbeginn (provisorisch)
#   N link_max_mm               60.0 mm, laengster Verbinder (0 = aus)
#   A r_blend                   min(2.0 mm, 1/2 Segmentlaenge)
#   A d_hard                    10.0 mm
#   A tau_max                   0.0 deg
#   A tcp_name                  FGC_30GUT (am Teach Pendant anlegen: tools/30gut.json,
#                               Position (134, 0, 73) mm, 90 deg um Flansch-Y)
#   A Dialekt                   v3 (Firmware am Teach Pendant pruefen)
#   A Schichtfolge              alternate (Druckmuster, opt-in)
#   A Muster                    Infill none, Outfill fugenwand
#   A Muster-Preset             docs/muster/presets/fugenwand_gurt.json
# Weitere Laufparameter: d_target_mm=50.0, d_target_printed_mm=20.0, dense_dq_rad=0.0049, dense_tcp_mm=4.9, dialect=v2, dq_max_rad=0.3, lambda_branch=5.0, lambda_d=0.2, lambda_link=1.0, lambda_psi=0.05, lambda_transfer=0.2, module_height_max_mm=400.0, psi_step_deg=15.0, r_free_mm=40.0, shells=2.0, spot_x_mm=0.0, spot_y_mm=-50.0, step_mm=20.0
#
# Fehlerfall: Der Rumpf steht in try/finally; finally setzt den Analogausgang auf 0 V.
# Ein Stopp am Teach Pendant beendet das Programm ggf. ohne finally: Pumpe dann pruefen.

set_velx(100.0, 60.0)
set_accx(500.0, 120.0)
set_velj([36.000, 36.000, 54.000, 67.500, 67.500, 67.500])
set_accj([144.000, 144.000, 216.000, 270.000, 270.000, 270.000])
set_tcp("FGC_30GUT")
set_singularity_handling(DR_VAR_VEL)
set_mode_analog_output(ch=1, mod=DR_ANALOG_VOLTAGE)
set_analog_output(ch=1, val=0.0)

